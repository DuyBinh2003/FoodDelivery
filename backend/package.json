{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build && tsc-alias",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:user": "nest start user-service --watch --exec \"tsc-alias -p apps/user-service/tsconfig.json && node\"",
    "start:restaurant": "nest start restaurant-service --watch --exec \"tsc-alias -p apps/restaurant-service/tsconfig.json && node\"",
    "start:order": "nest start order-service --watch --exec \"tsc-alias -p apps/order-service/tsconfig.json && node\"",
    "start:delivery": "nest start delivery-service --watch --exec \"tsc-alias -p apps/delivery-service/tsconfig.json && node\"",
    "start:admin": "nest start admin-service --watch --exec \"tsc-alias -p apps/admin-service/tsconfig.json && node\"",
    "start:search": "nest start search-service --watch --exec \"tsc-alias -p apps/search-service/tsconfig.json && node\"",
    "start:payment": "nest start payment-service --watch --exec \"tsc-alias -p apps/payment-service/tsconfig.json && node\"",
    "start:all": "concurrently \"npm run start:user\" \"npm run start:admin\" \"npm run start:restaurant\" \"npm run start:order\" \"npm run start:delivery\" \"npm run start:search\" \"npm run start:payment\"",
    "start:prod": "node dist/main",
    "lint": "oxlint apps/ libs/ test/ && node scripts/check-imports.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migrate:init": "node-pg-migrate -m migrations/init --schema public --migrations-schema public --migrations-table pgmigrations_init up",
    "migrate:user": "node-pg-migrate -m migrations/user-service --schema schema_user --migrations-schema schema_user --migrations-table pgmigrations up",
    "migrate:restaurant": "node-pg-migrate -m migrations/restaurant-service --schema schema_restaurant --migrations-schema schema_restaurant --migrations-table pgmigrations up",
    "migrate:order": "node-pg-migrate -m migrations/order-service --schema schema_order --migrations-schema schema_order --migrations-table pgmigrations up",
    "migrate:admin": "node-pg-migrate -m migrations/admin-service --schema schema_admin --migrations-schema schema_admin --migrations-table pgmigrations up",
    "migrate:payment": "node-pg-migrate -m migrations/payment-service --schema schema_payment --migrations-schema schema_payment --migrations-table pgmigrations up",
    "migrate:all": "npm run migrate:init && npm run migrate:user && npm run migrate:restaurant && npm run migrate:order && npm run migrate:admin && npm run migrate:payment",
    "migrate:up": "npm run migrate:all",
    "migrate:reset": "node scripts/reset-db.js && npm run migrate:all"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1147.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@elastic/elasticsearch": "^8.17.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/elasticsearch": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "node-pg-migrate": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqs-consumer": "^15.0.3",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.6",
    "glob": "^13.0.6",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-morph": "^28.0.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
