# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_QUALITY=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI Fallback
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=food-delivery-chatbox

# Tavily Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Database & External Services
POSTGRES_URI=postgresql://postgres:password@localhost:5432/food_delivery
ELASTICSEARCH_URL=http://localhost:9200
ORDER_SERVICE_URL=http://localhost:3004
USER_SERVICE_URL=http://localhost:3001

# RAG Thresholds
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
RAG_MAX_REWRITE_ATTEMPTS=2
