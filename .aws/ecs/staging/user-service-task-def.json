{
  "family": "fd-staging-user-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/fd-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/fd-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "user-service",
      "image": "ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/fd-user-service:staging-latest",
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "staging" },
        { "name": "PORT", "value": "3001" },
        { "name": "REDIS_HOST", "value": "STAGING_ELASTICACHE_ENDPOINT" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "AWS_REGION", "value": "ap-southeast-1" },
        { "name": "LOCALSTACK_ENDPOINT", "value": "" },
        { "name": "SQS_ENDPOINT", "value": "" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/database-url" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/jwt-secret" },
        { "name": "AWS_ACCESS_KEY_ID", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/aws-access-key-id" },
        { "name": "AWS_SECRET_ACCESS_KEY", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/aws-secret-access-key" },
        { "name": "SNS_USER_REGISTRATION_TOPIC", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/sns-user-registration-topic" },
        { "name": "SQS_QUEUE_URL", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:fd/staging/sqs-queue-url" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fd-staging/user-service",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3001/health', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))\""],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      },
      "essential": true
    }
  ]
}
