# ==========================================
# FOOD DELIVERY SYSTEM - ENVIRONMENT VARIABLES
# ==========================================

# 1. Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=food_delivery
DATABASE_URL=postgresql://postgres:password@localhost:5432/food_delivery

# 2. Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# 2b. Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200

# 3. Application Environment
NODE_ENV=development

# 4. Frontend & Gateway Configuration (Unified Entry :8080 | Frontend :3000)
GATEWAY_PORT=8080
PUBLIC_GATEWAY_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3100
NEXT_PUBLIC_API_GATEWAY_URL=/api
NEXT_PUBLIC_INTERNAL_API_GATEWAY_URL=http://localhost:8080/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_RESTAURANT_SERVICE_URL=http://localhost:4003
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:4004
NEXT_PUBLIC_DELIVERY_SERVICE_URL=http://localhost:4005
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:4006
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:4007
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:5001
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_ADMIN_WS_URL=/admin
NEXT_PUBLIC_ADMIN_WS_PATH=/ws/admin/socket.io
NEXT_PUBLIC_USER_WS_URL=/user
NEXT_PUBLIC_USER_WS_PATH=/ws/user/socket.io
NEXT_PUBLIC_DELIVERY_WS_URL=/delivery
NEXT_PUBLIC_DELIVERY_WS_PATH=/ws/delivery/socket.io

# 5. Auth Configuration
JWT_SECRET=super-secret-key-for-local-dev
JWT_EXPIRATION=7d

# 6. LocalStack / AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/food-delivery-orders
SQS_ADMIN_REGISTRATION_QUEUE_URL=http://localhost:4566/000000000000/admin-registration-queue
SQS_DRIVER_DISPATCH_QUEUE_URL=http://localhost:4566/000000000000/driver-dispatch-queue
SNS_ENDPOINT=http://localhost:4566
SNS_USER_REGISTRATION_TOPIC=arn:aws:sns:ap-southeast-1:000000000000:user-registration-events
SNS_ORDER_DRIVER_DISPATCH_TOPIC=arn:aws:sns:ap-southeast-1:000000000000:order-driver-dispatch
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=food-delivery-assets
S3_PUBLIC_URL_PREFIX=http://localhost:4566/food-delivery-assets

USER_SERVICE_PORT=4001
ADMIN_SERVICE_PORT=4002
RESTAURANT_SERVICE_PORT=4003
ORDER_SERVICE_PORT=4004
DELIVERY_SERVICE_PORT=4005
SEARCH_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007

ORDER_SERVICE_URL=http://localhost:4004
RESTAURANT_SERVICE_URL=http://localhost:4003
DELIVERY_SERVICE_URL=http://localhost:4005
SEARCH_SERVICE_URL=http://localhost:4006
USER_SERVICE_URL=http://localhost:4001
ADMIN_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4007
AI_SERVICE_URL=http://localhost:5001

# ==========================================
# 7. AI Service Orchestrator (NestJS :5001)
# ==========================================
AI_SERVICE_PORT=5001
LANGGRAPH_SERVICE_URL=http://localhost:5002
CHAT_SESSION_TTL_DAYS=30
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT_PER_MINUTE=20

# ==========================================
# 8. AI Python LangGraph Core (:5002)
# ==========================================
AI_PYTHON_PORT=5002
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_QUALITY=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_API_KEY=your_openai_api_key_here
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=food-delivery-chatbox
TAVILY_API_KEY=your_tavily_api_key_here
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
RAG_MAX_REWRITE_ATTEMPTS=2

