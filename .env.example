# ==========================================
# FOOD DELIVERY SYSTEM - ENVIRONMENT VARIABLES
# ==========================================

# 1. Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=food_delivery
DATABASE_URL=postgresql://postgres:password@localhost:5432/food_delivery

# 2. Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# 3. Application Environment
NODE_ENV=development

# 4. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_RESTAURANT_SERVICE_URL=http://localhost:3003
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_DELIVERY_SERVICE_URL=http://localhost:3005
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3006
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:3007
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_ADMIN_WS_URL=http://localhost:3002/admin
NEXT_PUBLIC_USER_WS_URL=http://localhost:3001/user

# 5. Auth Configuration
JWT_SECRET=super-secret-key-for-local-dev
JWT_EXPIRATION=7d

# 6. LocalStack / AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/food-delivery-orders
SQS_ADMIN_REGISTRATION_QUEUE_URL=http://localhost:4566/000000000000/admin-registration-queue
SQS_DRIVER_DISPATCH_QUEUE_URL=http://localhost:4566/000000000000/driver-dispatch-queue
SNS_ENDPOINT=http://localhost:4566
SNS_USER_REGISTRATION_TOPIC=arn:aws:sns:ap-southeast-1:000000000000:user-registration-events
SNS_ORDER_DRIVER_DISPATCH_TOPIC=arn:aws:sns:ap-southeast-1:000000000000:order-driver-dispatch

ORDER_SERVICE_URL=http://localhost:3004
RESTAURANT_SERVICE_URL=http://localhost:3003
DELIVERY_SERVICE_URL=http://localhost:3005
USER_SERVICE_URL=http://localhost:3001
ADMIN_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3007

