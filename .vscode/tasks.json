{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Build",
            "detail": "Xây dựng các Docker container của dự án",
            "type": "shell",
            "command": "docker-compose build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Run",
            "detail": "Khởi chạy toàn bộ hệ thống (Docker Compose)",
            "type": "shell",
            "command": "docker-compose up",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Stop",
            "detail": "Dừng và tắt toàn bộ các container đang chạy",
            "type": "shell",
            "command": "docker-compose down",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: Migrate Up",
            "detail": "Cập nhật cấu trúc (schema) của Database",
            "type": "shell",
            "command": "npm run migrate:up",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: Reset",
            "detail": "Xoá sạch dữ liệu và tạo lại Database từ đầu",
            "type": "shell",
            "command": "npm run migrate:reset",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Git: Create PR",
            "detail": "Tự động tạo nhánh (không dấu) và Draft PR từ Issue",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/create-pr.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CI: Frontend Lint",
            "detail": "Kiểm tra lỗi mã nguồn (Lint) cho Frontend",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Backend Lint",
            "detail": "Kiểm tra lỗi mã nguồn (Lint) cho Backend",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Backend Test",
            "detail": "Chạy kiểm thử (Unit Tests) cho Backend",
            "type": "shell",
            "command": "npm run test",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Run All",
            "detail": "Kiểm tra tổng thể toàn bộ dự án (Lint & Test)",
            "dependsOn": [
                "CI: Frontend Lint",
                "CI: Backend Lint",
                "CI: Backend Test"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}