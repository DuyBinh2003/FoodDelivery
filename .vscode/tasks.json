{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Build",
            "type": "shell",
            "command": "docker-compose build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Run",
            "type": "shell",
            "command": "docker-compose up",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Stop",
            "type": "shell",
            "command": "docker-compose down",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: Migrate Up",
            "type": "shell",
            "command": "npm run migrate:up",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: Reset",
            "type": "shell",
            "command": "npm run migrate:reset",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Git: Create PR",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "gh issue list -a '@me'; $id = Read-Host 'Nhập ID của task để tạo PR (hoặc Enter để hủy)'; if ($id) { Write-Host 'Đang tạo nhánh cho Issue...'; gh issue develop $id -c; Write-Host 'Đang tạo commit rỗng...'; git commit --allow-empty -m \"chore: start issue #$id\"; Write-Host 'Đang đẩy code lên remote...'; git push -u origin HEAD; Write-Host 'Đang tạo PR tự động...'; gh pr create --title \"Resolves #$id\" --body-file \".github/PULL_REQUEST_TEMPLATE.md\" }"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}