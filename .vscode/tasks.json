{
    "version": "2.0.0",
    "options": {
        "env": {
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8"
        }
    },
    "tasks": [
        // ============================================================
        //  🚀 DEV: Daily Development (Hybrid — Local + Docker Infra)
        // ============================================================
        {
            "label": "Dev: Start All",
            "detail": "Bật infrastructure Docker + Backend + Frontend cùng lúc",
            "dependsOn": [
                "Dev: Infra Up",
                "Dev: Backend",
                "Dev: Frontend"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Dev: Infra Up",
            "detail": "Khởi động Infrastructure (PostgreSQL, Redis, ES, LocalStack)",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml up -d",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Dev: Infra Down",
            "detail": "Tắt toàn bộ Infrastructure containers",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml down",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Dev: Backend",
            "detail": "Chạy NestJS Backend local (hot reload)",
            "type": "shell",
            "command": "npm run start:dev:local",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev-servers"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting compilation",
                    "endsPattern": "Nest application successfully started"
                }
            }
        },
        {
            "label": "Dev: Frontend",
            "detail": "Chạy Next.js Frontend local (Turbopack HMR)",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev-servers"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting",
                    "endsPattern": "Ready in"
                }
            }
        },
        {
            "label": "Dev: Infra Restart",
            "detail": "Restart toàn bộ Infrastructure containers",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml restart",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },

        // ============================================================
        //  🐳 Docker: Full Stack (cho CI/CD, Demo, Onboarding)
        // ============================================================
        {
            "label": "Docker: Build",
            "detail": "Xây dựng các Docker container của dự án (Full Stack)",
            "type": "shell",
            "command": "docker compose build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Run",
            "detail": "Khởi chạy toàn bộ hệ thống Full Stack (Docker Compose)",
            "type": "shell",
            "command": "docker compose up",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Stop",
            "detail": "Dừng và tắt toàn bộ các container đang chạy",
            "type": "shell",
            "command": "docker compose down",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },

        // ============================================================
        //  🗄️ DB: Database Management
        // ============================================================
        {
            "label": "DB: Migrate Up",
            "detail": "Cập nhật cấu trúc (schema) của Database",
            "type": "shell",
            "command": "npm run migrate:up",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: Reset",
            "detail": "Xoá sạch dữ liệu và tạo lại Database từ đầu",
            "type": "shell",
            "command": "npm run migrate:reset",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },

        // ============================================================
        //  ✅ CI: Quality Checks (Lint & Test)
        // ============================================================
        {
            "label": "CI: Frontend Lint",
            "detail": "Kiểm tra lỗi mã nguồn (Lint) cho Frontend",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Backend Lint",
            "detail": "Kiểm tra lỗi mã nguồn (Lint) cho Backend",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Backend Test",
            "detail": "Chạy kiểm thử (Unit Tests) cho Backend",
            "type": "shell",
            "command": "npm run test",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "CI: Run All",
            "detail": "Kiểm tra tổng thể toàn bộ dự án (Lint & Test)",
            "dependsOn": [
                "CI: Frontend Lint",
                "CI: Backend Lint",
                "CI: Backend Test"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },

        // ============================================================
        //  🔧 Git & GitHub
        // ============================================================
        {
            "label": "Git: Create PR",
            "detail": "Chọn Issue được assign cho user và tự động tạo Draft PR",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File '${workspaceFolder}/scripts/create-pr-interactive.ps1'",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "GithubCI",
            "detail": "Gửi yêu cầu thực thi workflow CI/CD cho nhánh hiện hành",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $env:LANG='C.UTF-8'; $env:LC_ALL='C.UTF-8'; $currentBranchName = git -c core.quotepath=false branch --show-current; if ($currentBranchName -eq 'develop') { Write-Host 'Bạn không thể chạy script này trên nhánh develop.'; exit 1; } Write-Host \"Đang gửi yêu cầu chạy CI cho nhánh: $currentBranchName...\"; gh workflow run ci-cd.yml --ref $currentBranchName; if ($LASTEXITCODE -eq 0) { Write-Host '🚀 Đã gửi yêu cầu chạy CI lên GitHub thành công!' } else { Write-Host '❌ Có lỗi xảy ra khi gửi yêu cầu chạy CI.' }"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}